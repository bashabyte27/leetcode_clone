{
  "model": "problems.problem",
  "pk": 15,
  "fields": {
    "order_num": 3,
    "title": "Check Leap year",
    "slug": "check-leap-year",
    "description": "3\tLeap Year Check\tWrite a Python program that asks the user to enter a year. Then check if the given year is a leap year or not. A year is a leap year if it is divisible by 4 but not divisible by 100, OR if it is divisible by 400. If the year is a leap year, print \"Leap year\". If not, print \"Not a leap year\". The program must take the year as input from the user.\tEasy",
    "difficulty": "easy",
    "acceptance_rate": "0.00",
