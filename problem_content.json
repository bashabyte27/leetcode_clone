  }
},
{
  "model": "problems.problem",
  "pk": 16,
  "fields": {
    "order_num": 4,
    "title": "Electricity Bill Calculator",
    "slug": "electricity-bill-calculator",
    "description": "Write a Python program that asks the user to enter the number of units of electricity consumed. Then calculate the total electricity bill based on the following slab rates: First 100 units are charged at 5 rupees per unit. Next 100 units (from 101 to 200) are charged at 7 rupees per unit. Any units beyond 200 are charged at 10 rupees per unit. Print the total bill amount as an integer. The program must take units as input from the user.",
    "difficulty": "easy",
    "acceptance_rate": "0.00",
